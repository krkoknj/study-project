# 이 파일을 .env로 복사해서 사용한다. .env는 커밋하지 않는다.

# --- PostgreSQL (docker-compose.yml이 읽는다) ---
POSTGRES_USER=studygroup
POSTGRES_PASSWORD=change-me
POSTGRES_DB=studygroup
POSTGRES_PORT=5432

# --- 애플리케이션 / Prisma ---
# 위 값과 일치해야 한다: postgresql://USER:PASSWORD@localhost:PORT/DB
DATABASE_URL="postgresql://studygroup:change-me@localhost:5432/studygroup"

# --- 테스트 (Vitest가 DATABASE_URL 대신 이 값을 사용한다) ---
TEST_DATABASE_URL="postgresql://studygroup:change-me@localhost:5432/studygroup_test"
